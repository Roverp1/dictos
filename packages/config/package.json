{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@dictos/config",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "test": "bun test && bun run check:schemas",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "generate:schemas": "bun run scripts/generate-schemas.ts",
    "check:schemas": "bun run scripts/generate-schemas.ts --check"
  },
  "dependencies": {
    "@dictos/errore": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "typescript": "^7.0.2"
  }
}
