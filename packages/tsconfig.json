{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Package build settings - emit type declarations
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "sourceMap": true,
    
    // Output settings
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false
  }
}
